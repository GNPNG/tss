def Xform "Fillmore"
{
    def Scope "Looks" {
        def Material "Deck"
        {
            token outputs:surface.connect = </Fillmore/Looks/Deck/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.18, 0.23)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Frame"
        {
            token outputs:surface.connect = </Fillmore/Looks/Frame/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.33, 0.37)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Equipment"
        {
            token outputs:surface.connect = </Fillmore/Looks/Equipment/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.31, 0.34)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Film"
        {
            token outputs:surface.connect = </Fillmore/Looks/Film/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.01, 0.43, 0.54)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Slides"
        {
            token outputs:surface.connect = </Fillmore/Looks/Slides/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.28, 0.67)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Overhead"
        {
            token outputs:surface.connect = </Fillmore/Looks/Overhead/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.73, 0.38, 0.08)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Glass"
        {
            token outputs:surface.connect = </Fillmore/Looks/Glass/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58, 0.78, 0.75)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Lumia"
        {
            token outputs:surface.connect = </Fillmore/Looks/Lumia/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.47, 0.27, 0.42)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Datum"
        {
            token outputs:surface.connect = </Fillmore/Looks/Datum/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.58, 0.44)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Floor"
        {
            token outputs:surface.connect = </Fillmore/Looks/Floor/PBR.outputs:surface>
            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.079, 0.113, 0.145)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "StudyImage"
        {
            token outputs:surface.connect = </Fillmore/Looks/StudyImage/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Fillmore/Looks/StudyImage/Image.outputs:rgb>
                float inputs:roughness = 1
                token outputs:surface
            }
            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Image"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @screen-study.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Fillmore/Looks/StudyImage/UV.outputs:result>
                float3 outputs:rgb
            }
        }
    }
    def Xform "Screen_One_Vinyl" (
        doc = "Documented 20 by 30 foot vinyl screen. Landscape orientation, elevation, trim and exact position are illustrative. Screen texture is a TSS oil study."
    )
    {
        double3 xformOp:translate = (0, 0.9, -1.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Mesh "Vinyl_30ft_by_20ft" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            bool doubleSided = true
            uniform token subdivisionScheme = "none"
            point3f[] points = [(-4.572,0,0),(4.572,0,0),(4.572,6.096,0),(-4.572,6.096,0)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0,1,2,3]
            texCoord2f[] primvars:st = [(0,0),(1,0),(1,1),(0,1)] (interpolation = "vertex")
            rel material:binding = </Fillmore/Looks/StudyImage>
        }
        def Mesh "Trim_Top" (
            prepend inherits = </UnitBox>
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double3 xformOp:translate = (0, 6.131, 0)
            float3 xformOp:scale = (9.27, 0.07, 0.09)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </Fillmore/Looks/Frame>
        }
        def Mesh "Trim_Bottom" (
            prepend inherits = </UnitBox>
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double3 xformOp:translate = (0, -0.035, 0)
            float3 xformOp:scale = (9.27, 0.07, 0.09)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </Fillmore/Looks/Frame>
        }
        def Mesh "Trim_0" (
            prepend inherits = </UnitBox>
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double3 xformOp:translate = (-4.607, 3.048, 0)
            float3 xformOp:scale = (0.07, 6.2, 0.09)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </Fillmore/Looks/Frame>
        }
        def Mesh "Trim_1" (
            prepend inherits = </UnitBox>
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double3 xformOp:translate = (4.607, 3.048, 0)
            float3 xformOp:scale = (0.07, 6.2, 0.09)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </Fillmore/Looks/Frame>
        }
    }
