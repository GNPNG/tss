#usda 1.0
(
    defaultPrim = "Fillmore"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "GNPNG Fillmore East rear-projection scale study (1968-71). Screen size and counts derive from Greg Zinman in the Joshua Light Show archive. Equipment envelopes, stage datum, platform dimensions, screen height and all exact placements are illustrative. +Z points toward the audience."
)

class Mesh "UnitBox" {
    uniform token subdivisionScheme = "none"
    point3f[] points = [(-0.5,-0.5,-0.5),(0.5,-0.5,-0.5),(0.5,0.5,-0.5),(-0.5,0.5,-0.5),(-0.5,-0.5,0.5),(0.5,-0.5,0.5),(0.5,0.5,0.5),(-0.5,0.5,0.5)]
    int[] faceVertexCounts = [4,4,4,4,4,4]
    int[] faceVertexIndices = [0,3,2,1,4,5,6,7,0,4,7,3,1,2,6,5,0,1,5,4,3,7,6,2]
    normal3f[] normals = [(0,0,-1),(0,0,1),(-1,0,0),(1,0,0),(0,-1,0),(0,1,0)] (interpolation = "uniform")
}

class Xform "FilmUnit"
{
    def Mesh "Body" (
        prepend inherits = </UnitBox>
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double3 xformOp:translate = (0, 0.2, 0)
        float3 xformOp:scale = (0.4, 0.4, 0.55)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Fillmore/Looks/Equipment>
    }
    def Cylinder "Reel01" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token axis = "X"
        double height = 0.08
        double radius = 0.22
        double3 xformOp:translate = (0, 0.53, -0.22)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Fillmore/Looks/Film>
    }
    def Cylinder "Reel02" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token axis = "X"
        double height = 0.08
        double radius = 0.19
        double3 xformOp:translate = (0, 0.53, 0.16)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Fillmore/Looks/Film>
    }
    def Cylinder "Lens" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token axis = "Z"
        double height = 0.17
        double radius = 0.08
        double3 xformOp:translate = (0, 0.24, 0.34)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Fillmore/Looks/Glass>
    }
}
